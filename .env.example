# Copy to .env and adjust. All variables are optional.
FINDOC_LOG_LEVEL=INFO
FINDOC_OUTPUT_DIR=outputs
# auto | cpu | cuda
FINDOC_DEVICE=auto
FINDOC_BLUR_THRESHOLD=100
FINDOC_MIN_COVERAGE=0.25
# Folder of custom cheque templates (see findoc templates export)
# FINDOC_TEMPLATES_DIR=data/templates
# sift | orb
FINDOC_FEATURE_METHOD=sift

# ---- Web service (Phase 8): needed by docker compose; change every CHANGE value ----
POSTGRES_PASSWORD=CHANGE-me-db-password
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
FINDOC_API_JWT_SECRET=CHANGE-me-to-a-long-random-string
# First admin, created on the first start when there are no users
FINDOC_API_ADMIN_EMAIL=admin@example.com
FINDOC_API_ADMIN_PASSWORD=CHANGE-me-admin-password
# Delete uploaded media after this many days (run: docker compose exec api findoc api purge)
FINDOC_API_RETENTION_DAYS=30
FINDOC_API_MAX_UPLOAD_MB=200
